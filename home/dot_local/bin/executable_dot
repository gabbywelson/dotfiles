#!/usr/bin/env bash
# dot: everyday commands for the dotfiles repo. Run `dot help`.
# Works from the repo too (scripts/bootstrap-*.sh call it before chezmoi has run).
set -euo pipefail

export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:/opt/homebrew/bin:$PATH"

repo=${DOTFILES_REPO:-}
if [ -z "$repo" ]; then
  src=$(chezmoi source-path 2>/dev/null) || src="$HOME/dotfiles/home"
  repo=$(dirname "$src")
fi
os=$(uname -s)
tilde="~"   # for ${path/#$HOME/$tilde}; bash 3.2 mishandles a literal \~ there

bold=$'\e[1m' blue=$'\e[34m' green=$'\e[32m' yellow=$'\e[33m' dim=$'\e[2m' reset=$'\e[0m'
[ -t 1 ] || bold='' blue='' green='' yellow='' dim='' reset=''
step() { printf '\n%s%s==>%s %s%s\n' "$bold" "$blue" "$reset$bold" "$*" "$reset"; }
note() { printf '%s%s%s\n' "$dim" "$*" "$reset"; }
warn() { printf '%swarning:%s %s\n' "$yellow" "$reset" "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

profile() {
  chezmoi execute-template '{{ .profile }}' 2>/dev/null || echo "${DOTFILES_PROFILE:-personal}"
}

usage() {
  cat <<EOF
${bold}dot${reset}: manage the dotfiles in ${repo/#$HOME/$tilde}

  ${bold}dot update${reset}      pull the repo, install/upgrade packages, apply config, update plugins
  ${bold}dot apply${reset}       apply config only (chezmoi apply)
  ${bold}dot diff${reset}        preview what \`dot apply\` would change
  ${bold}dot edit${reset} [FILE] edit a managed file (e.g. ~/.zshrc) and apply it; no FILE opens the repo
  ${bold}dot doctor${reset}      check tools, fonts, config validity and drift
  ${bold}dot packages${reset}    install/upgrade packages only (Homebrew, or apt + mise)
  ${bold}dot plugins${reset}     update zsh plugins, themes, caches and completions
  ${bold}dot status${reset}      uncommitted repo changes and local drift
  ${bold}dot save${reset} [FILE] copy settings you changed locally (T3 Code's UI, by hand) back into the repo
  ${bold}dot cd${reset}          cd into the repo (zsh function)
EOF
}

packages() {
  step "Packages ($(profile) profile)"
  if [ "$os" = Darwin ]; then
    have brew || { warn "Homebrew is missing; run scripts/bootstrap-darwin.sh"; return 1; }
    # Apps installed from their websites update themselves: don't make brew fight them.
    local skip=${HOMEBREW_BUNDLE_CASK_SKIP:-} pair cask app
    for pair in "ghostty:Ghostty.app" "t3-code@nightly:T3 Code (Nightly).app"; do
      cask=${pair%%:*} app=${pair#*:}
      if [ -d "/Applications/$app" ] && ! brew list --cask "$cask" >/dev/null 2>&1; then
        skip="$skip $cask"
        note "$app wasn't installed by Homebrew; skipping it (to hand it over: brew install --cask --adopt $cask)"
      fi
    done
    HOMEBREW_BUNDLE_CASK_SKIP="${skip# }" HOMEBREW_DOTFILES_PROFILE=$(profile) \
      brew bundle --file="$repo/packages/Brewfile" || warn "brew bundle reported problems (see above)"
  else
    local missing=() pkg
    while read -r pkg; do
      dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'ok installed' || missing+=("$pkg")
    done < <(grep -Ev '^[[:space:]]*(#|$)' "$repo/packages/debian.txt")
    if [ ${#missing[@]} -gt 0 ]; then
      note "apt: installing ${missing[*]}"
      local sudo=sudo; [ "$(id -u)" = 0 ] && sudo=
      $sudo apt-get update -qq && $sudo apt-get install -y "${missing[@]}"
    else
      note "apt: all $(grep -Evc '^[[:space:]]*(#|$)' "$repo/packages/debian.txt") packages present"
    fi
    # Debian renames these binaries.
    mkdir -p "$HOME/.local/bin"
    have fd || { have fdfind && ln -sfn "$(command -v fdfind)" "$HOME/.local/bin/fd"; }
    if have mise; then
      mise install --yes || warn "some mise tools failed to install (see above)"
      mise upgrade --yes || warn "mise upgrade reported problems"
    fi
  fi
}

plugins() {
  step "Plugins, themes and caches"
  local cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
  chezmoi apply --refresh-externals --include=externals >/dev/null 2>&1 || warn "refreshing externals failed"
  if [ -r "$HOME/.antidote/antidote.zsh" ] && have zsh; then
    mkdir -p "$cache"
    # Bundling clones any new plugins; then pull updates for all of them.
    zsh -c 'source ~/.antidote/antidote.zsh && antidote bundle <~/.config/zsh/plugins.txt >|"$1" && antidote update' \
      _ "$cache/plugins.zsh" >/dev/null 2>&1 || warn "antidote update failed"
  fi
  for b in bat batcat; do have "$b" && { "$b" cache --build >/dev/null; break; }; done
  have tldr && { tldr --update >/dev/null 2>&1 || true; }
  rm -f "$cache"/init-*.zsh   # rebuilt on next shell start
  [ "$os" = Linux ] && completions
  note "done; open a new shell (or run \`exec zsh\`) to pick everything up"
}

# Linux: mise-installed tools ship no zsh completions, so generate them.
completions() {
  local dir="$HOME/.local/share/zsh/site-functions"
  mkdir -p "$dir"
  gen() { local name=$1; shift; have "$1" && "$@" >"$dir/_$name" 2>/dev/null || rm -f "$dir/_$name"; }
  gen gh gh completion -s zsh
  gen jj jj util completion zsh
  gen just just --completions zsh
  gen rg rg --generate complete-zsh
  gen fd fd --gen-completions zsh
  gen bat bat --completion zsh
  gen delta delta --generate-completion zsh
  gen starship starship completions zsh
  gen atuin atuin gen-completions --shell zsh
  gen mise mise completion zsh
  gen chezmoi chezmoi completion zsh
  gen uv uv generate-shell-completion zsh
  gen yq yq shell-completion zsh
  rm -f "$HOME/.zcompdump"   # rebuild the completion cache next shell
}

# Targets changed on this machine since chezmoi last wrote them (e.g. by an app's UI).
locally_changed() {
  chezmoi status 2>/dev/null | awk 'substr($0, 1, 1) == "M" { print substr($0, 4) }'
}

save() {
  step "Copying local changes into the repo"
  if [ $# -eq 0 ]; then
    # Only files changed *here*. A bare `chezmoi re-add` would also copy back every
    # file the repo changed but you haven't applied yet, undoing those changes.
    local path
    while IFS= read -r path; do set -- "$@" "$HOME/$path"; done < <(locally_changed)
    if [ $# -eq 0 ]; then
      note "nothing changed locally"
      return 0
    fi
  fi
  chezmoi re-add "$@"   # templates (*.tmpl) are skipped: edit those with `dot edit`
  # The repo is public: catch tokens an app may have written into its settings.
  if git -C "$repo" diff -U0 -- home | grep -iE '^\+.*(password|secret|token|api_?key)[a-z_]*"?[[:space:]]*[:=][[:space:]]*"[^"]+"'; then
    warn "the lines above look like secrets; remove them before committing"
  fi
  git -C "$repo" status --short -- home
  note "review with \`git -C ${repo/#$HOME/$tilde} diff\`, then commit and push"
}

update() {
  local changed
  changed=$(locally_changed | paste -sd, - | sed 's/,/, /g')
  if [ -n "$changed" ]; then
    warn "changed on this machine since the last apply: $changed"
    note "to keep those changes, stop here (Ctrl-C) and run \`dot save\`; otherwise chezmoi asks before overwriting each"
  fi
  step "Pulling $repo"
  if git -C "$repo" diff --quiet && git -C "$repo" diff --cached --quiet; then
    git -C "$repo" pull --rebase --quiet && git -C "$repo" log -1 --format="${dim}now at %h %s (%cr)${reset}"
  else
    warn "repo has uncommitted changes; skipping pull (commit or stash, then rerun)"
  fi
  packages
  step "Applying config"
  chezmoi init --source "$repo"   # regenerate chezmoi's config; saved answers are reused
  chezmoi apply
  plugins
}

case "${1:-help}" in
  update | up) update ;;
  apply) shift; chezmoi apply "$@" ;;
  diff) shift; chezmoi diff "$@" ;;
  edit)
    shift
    if [ $# -gt 0 ]; then
      chezmoi edit --apply "$@"
    else
      editor=${VISUAL:-${EDITOR:-vi}}
      exec ${editor% --wait} "$repo"   # a folder: don't block the shell
    fi ;;
  doctor) shift; exec dev-doctor "$@" ;;
  packages | pkgs) packages ;;
  plugins) plugins ;;
  completions) completions ;;
  save) shift; save "$@" ;;
  status | st)
    git -C "$repo" status --short --branch
    drift=$(chezmoi status 2>/dev/null || true)
    if [ -n "$drift" ]; then
      printf '\n%slocal drift%s (`dot diff` shows how; `dot save` keeps the local version):\n%s\n' "$yellow" "$reset" "$drift"
    fi ;;
  cd) echo "dot cd is a zsh function; in other shells: cd \"$repo\"" >&2; exit 1 ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 2 ;;
esac

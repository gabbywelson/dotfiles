{{- /*
  chezmoi's own config, generated by `chezmoi init` (bootstrap and `dot update` run it).
  The questions are asked once per machine; answers are saved in
  ~/.config/chezmoi/chezmoi.toml. Re-answer them with `chezmoi init --prompt`, or answer
  up front: chezmoi init --promptChoice "Machine profile=work" --promptString "Git email=me@work.com"
  Profiles: personal = homelab SSH hosts, 1Password SSH agent, Orrery vault; work = none of that.
*/ -}}
{{- $profile := promptChoiceOnce . "profile" "Machine profile" (list "personal" "work") "personal" -}}
{{- $name := promptStringOnce . "name" "Git name" "Gabby Welson" -}}
{{- $email := promptStringOnce . "email" "Git email" "gabby@welson.net" -}}

sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
    profile = {{ $profile | quote }}
    name = {{ $name | quote }}
    email = {{ $email | quote }}
{{- if lookPath "delta" }}

[diff]
    pager = "delta"
{{- end }}

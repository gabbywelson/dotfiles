# ~/.gitconfig
# Sensible Git defaults for modern development

[user]
    name = Gabby Welson
    email = gabby@welson.net

[init]
    defaultBranch = main

[core]
{{- if eq .chezmoi.os "darwin" }}
    editor = cursor --wait
{{- else }}
    editor = vim
{{- end }}
    pager = delta
    autocrlf = input
    ignorecase = {{ if eq .chezmoi.os "darwin" }}true{{ else }}false{{ end }}
    untrackedCache = true
    fsmonitor = false
    excludesFile = ~/.config/git/ignore

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    default = current

[fetch]
    prune = true
    pruneTags = true

[merge]
    conflictstyle = zdiff3

[rebase]
    autoStash = true
    autoSquash = true

[diff]
    colorMoved = default
    algorithm = histogram

[rerere]
    enabled = true

# ============================================
# Delta (Beautiful Diffs)
# ============================================

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    light = false
    side-by-side = false
    line-numbers = true
    syntax-theme = Catppuccin Mocha

[delta "decorations"]
    commit-decoration-style = bold yellow box ul
    file-style = bold yellow ul
    file-decoration-style = none
    hunk-header-decoration-style = cyan box ul

# ============================================
# Aliases
# ============================================

[alias]
    # Status & Info
    st = status -sb
    last = log -1 HEAD --stat
    who = shortlog -sn --no-merges

    # Branching
    co = switch
    cob = switch -c
    br = branch
    bra = branch -a

    # Committing
    cm = commit -m
    ca = commit --amend
    can = commit --amend --no-edit

    # Staging
    aa = add --all
    ap = add --patch

    # Logging (pretty!)
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    ll = log --oneline -20
    today = log --since=midnight --oneline --no-merges

    # Diff
    df = diff
    dfs = diff --staged

    # Stash
    sl = stash list
    sp = stash pop
    ss = stash push -m

    # Undo / Reset
    unstage = restore --staged
    discard = restore --worktree

    # Show all aliases
    aliases = config --get-regexp alias

# ============================================
# URL Shortcuts
# ============================================

[url "git@github.com:"]
    insteadOf = gh:

[url "git@gitlab.com:"]
    insteadOf = gl:

# ============================================
# Colors
# ============================================

[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "status"]
    added = green
    changed = yellow
    untracked = red

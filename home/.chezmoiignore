# Targets chezmoi skips on some machines (paths are relative to $HOME).

{{ if eq .chezmoi.os "darwin" }}
# Linux-only: bash fallback config, systemd units, mise-managed CLI toolbox.
.bashrc
.inputrc
.config/bash/
.config/systemd/
.config/mise/conf.d
{{ else }}
# macOS-only: GUI terminal config, T3 Code settings.
.config/ghostty/
.t3/
{{- /* Only hosts with the Orrery vault cloned get the sync timer. */}}
{{- if not (stat (joinPath .chezmoi.homeDir "vaults/orrery")) }}
.config/systemd/user/orrery-sync.*
{{- end }}
{{ end }}

{{ if ne .profile "personal" }}
# Personal-only: the Orrery knowledge vault helper.
.local/bin/orrery
{{ end }}

# atuin: shell history in a searchable database. https://docs.atuin.sh/configuration/config/
# Ctrl-R opens search; Ctrl-R again cycles global / host / session / directory / workspace.
# Sync across machines is opt-in and end-to-end encrypted: `atuin login` (or `atuin setup`).
# Your login and encryption key live in ~/.local/share/atuin, never in this repo.

style = "compact"         # one line per command, no frame
inline_height = 24        # open under the prompt instead of taking the whole screen
show_preview = true       # long commands get a preview pane
enter_accept = true       # Enter runs the command; Tab puts it on the line to edit first
workspaces = true         # "workspace" filter: commands run anywhere in this git repo
search_mode = "daemon-fuzzy"   # fuzzy search served by the background daemon (fast on big histories)

[sync]
records = true            # sync v2

# A background daemon handles sync and search; atuin starts it on demand.
[daemon]
enabled = true
autostart = true

# Atuin AI: type `?` at an empty prompt and describe the command you want.
# Needs `atuin login`. Nothing about your shell is sent unless you allow it:
# atuin's defaults keep the working directory and last command private, and it
# asks before searching history, reading files or running commands.
[ai]
{{- if eq .profile "personal" }}
enabled = true
{{- else }}
# Off on work machines, so no work context reaches a third-party AI service.
# Allowed at your company? Set this to true.
enabled = false
{{- end }}

# Ghostty: https://ghostty.org/docs/config
# Managed by chezmoi: edit ~/dotfiles/home/dot_config/ghostty/config, then `chezmoi apply`
# (Cmd-Shift-, reloads). Every option, documented: `ghostty +show-config --default --docs`.
# Check for typos without restarting: `ghostty +validate-config` (run by `dot doctor`).

# --- Theme ---------------------------------------------------------------------
# Catppuccin that follows macOS appearance: Latte by day, Mocha by night.
# The prompt, fzf, eza, bat and friends pick up the switch automatically.
# Theme names are case-sensitive (Ghostty 1.2+): browse them with `ghostty +list-themes`.
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# --- Font ----------------------------------------------------------------------
# The first installed family wins. Berkeley Mono is commercial (usgraphics.com);
# JetBrains Mono Nerd Font comes from the Brewfile. Icons work with any font,
# because Ghostty bundles the Nerd Font symbols.
font-family = "Berkeley Mono"
font-family = "JetBrainsMono Nerd Font"
font-size = 14

# --- Window --------------------------------------------------------------------
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
# Let full-screen apps (lazygit, btop, yazi) paint into the padding, edge to edge.
window-padding-color = extend
window-width = 120
window-height = 34
window-save-state = always

background-opacity = 0.96
background-blur = 20
unfocused-split-opacity = 0.85

cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true

# --- Clipboard -----------------------------------------------------------------
copy-on-select = true
# Programs (also over SSH, e.g. tmux) may copy to the clipboard; reading it asks first.
clipboard-write = allow
clipboard-read = ask

# --- Shell integration -----------------------------------------------------------
# Prompt marks (Cmd-Up/Down jumps between prompts, click to move the cursor),
# a bar cursor at the prompt, titles, and SSH niceties: Ghostty installs its
# terminfo on remote hosts the first time you ssh to them.
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,path

# Finished a command that ran 10s+ while you were in another app? Get a notification.
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 10s

# --- Keyboard ---------------------------------------------------------------------
# Left Option acts as Alt (word jumps, Alt-C for fzf); right Option still types é, ü, …
macos-option-as-alt = left

# Ghostty's defaults are good: `ghostty +list-keybinds --default` lists them.
# Highlights: Cmd-D / Cmd-Shift-D split, Cmd-Shift-Enter zooms a split,
# Cmd-F searches scrollback, Cmd-Shift-P opens the command palette.

# Drop-down terminal from anywhere with Ctrl-` (needs Accessibility permission).
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 40%
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-space-behavior = move

# --- Machine-local overrides ------------------------------------------------------
# Unmanaged, optional: font size for a big monitor, a different font, etc.
config-file = ?config.local

# ~/.zprofile: login shells (every new terminal tab on macOS, every SSH login).

# Homebrew env (HOMEBREW_PREFIX, MANPATH, ...). macOS's /etc/zprofile just ran
# path_helper, which moved system dirs ahead of ours, so re-run ~/.zshenv to put
# Homebrew and user tool dirs back in front.
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
source ~/.zshenv
{{- if eq .profile "personal" }}

# Orrery knowledge vault (see `orrery help`).
export ORRERY_VAULT="{{ if eq .chezmoi.os "darwin" }}$HOME/Documents/Notes/Orrery{{ else }}$HOME/vaults/orrery{{ end }}"
{{- end }}
{{- if eq .chezmoi.os "darwin" }}

# Obsidian's CLI (`obsidian help`), when the app is installed.
[[ -d /Applications/Obsidian.app/Contents/MacOS ]] && path+=(/Applications/Obsidian.app/Contents/MacOS)

# Added by OrbStack: command-line tools and integration
source ~/.orbstack/shell/init.zsh 2>/dev/null || :
{{- end }}

# ~/.config/ghostty/config
# macOS Ghostty configuration managed by chezmoi
#
# Docs: https://ghostty.org/docs/config

# ============================================
# Font
# ============================================

# Primary font (Nerd Font for icons)
font-family = MesloLGS Nerd Font
font-size = 14

# Catppuccin everywhere: Latte in light mode, Mocha in dark (follows macOS).
theme = light:catppuccin-latte,dark:catppuccin-mocha

# ============================================
# Window
# ============================================

# Comfortable padding
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true

# Initial size (columns x rows)
window-width = 120
window-height = 35

# Remember window position/size
window-save-state = always

# Title
window-title-font-family = MesloLGS Nerd Font

# ============================================
# Appearance
# ============================================

# Slight transparency for aesthetic (1.0 = fully opaque)
background-opacity = 0.96

# Blur background when transparent (macOS)
background-blur-radius = 20

# Cursor
cursor-style = bar
cursor-style-blink = true

# Keep background panes readable while making the focused split obvious
unfocused-split-opacity = 0.85

# ============================================
# Behavior
# ============================================

# Clipboard
clipboard-read = allow
clipboard-write = allow
copy-on-select = true

# Mouse
mouse-hide-while-typing = true

# Shell integration
shell-integration = zsh
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,path

# Use left Option for terminal shortcuts while preserving right Option for
# macOS Unicode characters.
macos-option-as-alt = left

# Confirm before closing with running processes
confirm-close-surface = true

# ============================================
# Performance
# ============================================

# VSync for smooth rendering
window-vsync = true

# ============================================
# Keybindings
# ============================================

# Ghostty has great defaults, minimal customization needed
# See: ghostty +show-keys for current bindings

# Drop-down terminal from anywhere (requires macOS Accessibility permission)
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 40%
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-space-behavior = move

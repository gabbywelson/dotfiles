<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.welson.orrery-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/.local/bin/orrery</string>
    <string>sync</string>
    <string>--actor</string>
    <string>gabby-auto</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>LowPriorityIO</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>{{ .chezmoi.homeDir }}/Documents/Notes/Orrery</string>
  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/state/orrery/sync.log</string>
  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/state/orrery/sync.err.log</string>
</dict>
</plist>

[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
export ORRERY_VAULT="$HOME/Documents/Notes/Orrery"

# Optional application CLIs.
[ -d /Applications/Obsidian.app/Contents/MacOS ] && export PATH="$PATH:/Applications/Obsidian.app/Contents/MacOS"

# Keep MCP credentials in Keychain instead of plaintext agent configuration.
if command -v security >/dev/null 2>&1; then
  UIDOTSH_AUTHORIZATION=$(security find-generic-password -a "$USER" -s dev.uidotsh.authorization -w 2>/dev/null || true)
  [ -n "$UIDOTSH_AUTHORIZATION" ] && export UIDOTSH_AUTHORIZATION
fi

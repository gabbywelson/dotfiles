# macOS packages. `dot packages` installs and upgrades them (it runs
# `brew bundle --file packages/Brewfile` with your machine profile).
# Homebrew hides other env vars from Brewfiles, hence the HOMEBREW_ prefix.
# Linux gets the same toolbox from packages/debian.txt + ~/.config/mise/conf.d.

personal = ENV.fetch("HOMEBREW_DOTFILES_PROFILE", "personal") == "personal"

# --- Terminal, shell & prompt ----------------------------------------------------
cask "ghostty"                      # the terminal
cask "t3-code@nightly"              # GUI for coding agents; settings live in ~/.t3/userdata
cask "font-jetbrains-mono-nerd-font"
brew "starship"                     # prompt
brew "atuin"                        # searchable, synced shell history (Ctrl-R)
brew "zoxide"                       # `z proj` jumps to frecent dirs
brew "fzf"                          # fuzzy finder behind Ctrl-T, Alt-C, Tab
brew "chezmoi"                      # applies this repo to $HOME
brew "mise"                         # per-project runtimes (node, python, ...)
brew "direnv"                       # per-project env vars

# --- Modern replacements for the classics -------------------------------------
brew "eza"                          # ls
brew "bat"                          # cat
brew "fd"                           # find
brew "ripgrep"                      # grep
brew "git-delta"                    # diff pager
brew "dust"                         # du
brew "duf"                          # df
brew "btop"                         # top
brew "sd"                           # sed for find & replace
brew "xh"                           # curl for APIs
brew "tealdeer"                     # tldr: example-first man pages
brew "tree"

# --- Files, docs & data ----------------------------------------------------------
brew "yazi"                         # terminal file manager (`y`)
brew "glow"                         # render Markdown in the terminal
brew "jq"
brew "yq"

# --- Git ----------------------------------------------------------------------------
brew "git"
brew "gh"
brew "lazygit"                      # git TUI (`lg`)
brew "difftastic"                   # syntax-aware diffs (`gdt`)
brew "jj"                           # Jujutsu, a friendlier Git-compatible VCS

# --- Dev workflow ---------------------------------------------------------------------
brew "uv"                           # Python packages, venvs and versions
brew "just"                         # command runner
brew "watchexec"                    # rerun on file changes
brew "hyperfine"                    # benchmarking
brew "tokei"                        # count lines of code
brew "fastfetch"                    # system summary (`ff`)
brew "wget"
brew "docker"                       # CLI for OrbStack and remote Docker hosts
brew "docker-compose"
brew "docker-credential-helper"
brew "xcbeautify"                   # readable xcodebuild output

# --- Personal machines only ---------------------------------------------------------
if personal
  cask "1password-cli"              # `op`; SSH keys come from the 1Password agent
end

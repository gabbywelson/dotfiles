# Login shells, including `sh -lc` used by agents and t3code: user tools + mise shims.
for dir in "$HOME/.local/share/mise/shims" "$HOME/.local/bin"; do
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) [ -d "$dir" ] && PATH="$dir:$PATH" ;;
  esac
done
unset dir
export PATH
export ORRERY_VAULT="{{ if eq .chezmoi.os "darwin" }}$HOME/Documents/Notes/Orrery{{ else }}$HOME/vaults/orrery{{ end }}"
{{- if eq .chezmoi.os "linux" }}

# SSH starts Bash as a login shell, so load the interactive shell setup here.
# .bashrc returns immediately for noninteractive shells.
if [ -n "${BASH_VERSION:-}" ] && [ -r "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
{{- end }}

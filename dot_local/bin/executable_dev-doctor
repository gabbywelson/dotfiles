#!/usr/bin/env bash
set -u
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

fail=0
check() {
  if command -v "$1" >/dev/null 2>&1; then printf 'ok   %-12s %s\n' "$1" "$(command -v "$1")"
  else printf 'MISS %-12s\n' "$1"; fail=1; fi
}

echo "host: $(hostname) ($(uname -s) $(uname -m))"
for tool in zsh git chezmoi rg fd fzf bat eza zoxide atuin delta lazygit starship tmux gh mise direnv jq yq node; do check "$tool"; done
[ -r "$HOME/.antidote/antidote.zsh" ] && echo 'ok   antidote' || { echo 'MISS antidote'; fail=1; }
[ -d "$HOME/.tmux/plugins/tmux-resurrect" ] && echo 'ok   tmux plugins' || { echo 'MISS tmux plugins (prefix + I)'; fail=1; }
for agent in codex claude; do check "$agent"; done
[ -d "$HOME/code" ] || { echo "MISS ~/code"; fail=1; }
git config --global user.email | grep -qx 'gabby@welson.net' || { echo 'MISS personal Git identity'; fail=1; }
if [ "$(uname -s)" = Linux ]; then
  check docker
  docker info >/dev/null 2>&1 || { echo 'MISS usable Docker daemon'; fail=1; }
fi
exit "$fail"
